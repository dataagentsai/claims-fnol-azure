# Copy to .env and fill in. .env is gitignored; never commit it.
#
# Which overlay the app is built from: config/local.yaml (this Mac), test, or azure
# (Tier 4). The overlay names the adapters; this only picks the file.
CLAIMS_FNOL_ENV=local

# The claims system's database and the DBOS waits' database, on the local
# PostgreSQL service (a dedicated role; see README "Run it on your Mac").
CLAIMS_DATABASE_URL=postgresql://claims_fnol:<password>@127.0.0.1:5432/claims_fnol
CLAIMS_DBOS_DATABASE_URL=postgresql://claims_fnol:<password>@127.0.0.1:5432/claims_fnol_dbos

# The same server with no database: tests create and drop their own there.
CLAIMS_TEST_SERVER_URL=postgresql://claims_fnol:<password>@127.0.0.1:5432

# The model provider's key (Groq, OpenAI-compatible). Model and endpoint are
# pinned in harness-profile.yaml and claims_fnol.config.Settings.
GROQ_API_KEY=<your-groq-key>
