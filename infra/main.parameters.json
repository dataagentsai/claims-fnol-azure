{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "principalName": { "value": "${AZURE_PRINCIPAL_NAME}" },
    "budgetContactEmail": { "value": "${BUDGET_CONTACT_EMAIL}" },
    "ownerIpAddress": { "value": "${OWNER_IP_ADDRESS}" },
    "groqKeyInVault": { "value": "${GROQ_KEY_IN_VAULT=false}" },
    "entraSecretInVault": { "value": "${ENTRA_SECRET_IN_VAULT=false}" },
    "entraAppId": { "value": "${ENTRA_APP_ID=}" },
    "claimsSystemAppId": { "value": "${CLAIMS_SYSTEM_APP_ID=}" },
    "postgresAdminPassword": { "value": "$(secretOrRandomPassword ${AZURE_KEY_VAULT_NAME} postgres-admin-password)" },
    "postgresAgentPassword": { "value": "$(secretOrRandomPassword ${AZURE_KEY_VAULT_NAME} postgres-agent-password)" },
    "postgresClaimsSystemPassword": { "value": "$(secretOrRandomPassword ${AZURE_KEY_VAULT_NAME} postgres-claims-system-password)" },
    "sessionKey": { "value": "$(secretOrRandomPassword ${AZURE_KEY_VAULT_NAME} agent-session-key)" },
    "agentImage": { "value": "${AGENT_IMAGE=mcr.microsoft.com/k8se/quickstart:latest}" },
    "claimsSystemImage": { "value": "${CLAIMS_SYSTEM_IMAGE=mcr.microsoft.com/k8se/quickstart:latest}" }
  }
}
