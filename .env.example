# Copy to .env and fill in. .env is gitignored; never commit it.
#
# Which overlay the app is built from: config/local.yaml (this Mac), test, or azure
# (Tier 4). The overlay names the adapters; this only picks the file.
CLAIMS_FNOL_ENV=local

# The admin login (the `claims_fnol` role; CREATEDB, CREATEROLE), no database in
# the URL. Only scripts/dev-up.sh uses it, to make the databases and the two app
# logins (A4, infra/sql/roles.sql). No app runs as it.
CLAIMS_ADMIN_URL=postgresql://claims_fnol:<password>@127.0.0.1:5432

# The apps' own logins. scripts/dev-up.sh writes these four lines itself, with a
# password made once per role; you need not fill them in.
#   the claims system (claims_system): its database, and the agent's approval
#   records, which that role may only SELECT
CLAIMS_DATABASE_URL=postgresql://claims_system:<made-by-dev-up>@127.0.0.1:5432/claims_fnol
CLAIMS_RECORDS_DATABASE_URL=postgresql://claims_system:<made-by-dev-up>@127.0.0.1:5432/claims_fnol_dbos
#   the agent (claims_agent): its state, its records and the DBOS waits
CLAIMS_DBOS_DATABASE_URL=postgresql://claims_agent:<made-by-dev-up>@127.0.0.1:5432/claims_fnol_dbos

# The same server with no database, as the admin login: tests create and drop
# their own databases and roles there.
CLAIMS_TEST_SERVER_URL=postgresql://claims_fnol:<password>@127.0.0.1:5432

# The model provider's key (Groq, OpenAI-compatible). Model and endpoint are
# pinned in harness-profile.yaml and claims_fnol.config.Settings.
GROQ_API_KEY=<your-groq-key>
